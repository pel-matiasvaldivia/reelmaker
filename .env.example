# Copiá este archivo como .env y ajustá lo que necesites.

# Imagen a usar. Fijá una etiqueta concreta (por ejemplo :sha-1a2b3c4) si no querés
# que un `docker compose pull` traiga cambios sin avisar.
REELMAKER_IMAGE=ghcr.io/pel-matiasvaldivia/reelmaker:latest

# Puerto del host donde queda la app cuando la publicás sin Caddy.
REELMAKER_PORT=8080

# Solo para el perfil tls: dominio ya apuntando por DNS a la IP del VPS.
REELMAKER_DOMAIN=reels.tudominio.com

# Copiá este archivo como .env y ajustá lo que necesites.

# Imagen a usar. Fijá una etiqueta concreta (por ejemplo :sha-1a2b3c4) si no querés
# que un `docker compose pull` traiga cambios sin avisar.
REELMAKER_IMAGE=ghcr.io/pel-matiasvaldivia/reelmaker:latest

# Puerto del host donde queda la app cuando la publicás sin Caddy.
REELMAKER_PORT=8080

# Cuenta del primer administrador, creada en el primer arranque.
# Si las dejás vacías, se genera una contraseña al azar que aparece una sola vez
# en los logs: docker compose logs reelmaker | grep "primer ingreso"
REELMAKER_ADMIN_USER=
REELMAKER_ADMIN_PASSWORD=

# Clave para firmar las cookies de sesión. Si la dejás vacía se genera una y se
# guarda en el volumen de datos. Si la cambiás, se cierran todas las sesiones.
REELMAKER_SECRET=

# Solo para el perfil tls: dominio ya apuntando por DNS a la IP del VPS.
REELMAKER_DOMAIN=reels.tudominio.com
